---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tooltip from '../components/Tooltip.astro';
import MetricSelector from '../components/MetricSelector.astro';
import Legend from '../components/Legend.astro';
import ZoomControls from '../components/ZoomControls.astro';
---

<BaseLayout title="D3 Globe">
  <main class="relative min-h-[100dvh] overflow-hidden">
    <h1 class="sr-only">D3 Globe</h1>

    <div
      data-container
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
    >
    </div>

    <Tooltip />
    <MetricSelector />
    <Legend />
    <ZoomControls />
  </main>
</BaseLayout>

<script>
  import '../scripts/globe.js';
</script>
